# =================================================================
# ZYQORA BACKEND ENVIRONMENT CONFIGURATION (RENDER & PRODUCTION)
# =================================================================

# Server Settings
PORT=5000
NODE_ENV=production

# Database (PostgreSQL / Supabase / Neon / Render Postgres)
DATABASE_URL="postgresql://username:password@hostname:5432/database?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="replace_with_a_secure_random_string_min_32_chars"
JWT_REFRESH_SECRET="replace_with_another_secure_random_string_min_32_chars"

# Frontend URLs (Comma-separated list for multiple origins like staging/production)
CLIENT_URL="https://zyqora-frontend.vercel.app"
CLIENT_URLS="https://zyqora-frontend.vercel.app,http://localhost:5173"

# =================================================================
# SENDGRID EMAIL SERVICE (HTTPS API - Fully Works on Render Free Tier)
# =================================================================
# Get API Key from: https://app.sendgrid.com/settings/api_keys (Mail Send access)
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
# Must be a verified Sender Identity or Domain in SendGrid
SENDGRID_FROM_EMAIL="support@yourverifieddomain.com"
SENDGRID_FROM_NAME="Zyqora"

# =================================================================
# CLOUDINARY (Product image & avatar uploads)
# =================================================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# =================================================================
# RAZORPAY (Payments & Checkout)
# =================================================================
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# =================================================================
# OAUTH PROVIDERS (Optional / Social Login)
# =================================================================
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="https://your-backend-api.onrender.com/api/auth/google/callback"

FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
FACEBOOK_CALLBACK_URL="https://your-backend-api.onrender.com/api/auth/facebook/callback"

# =================================================================
# GEOCODING & MAPS (LocationIQ)
# =================================================================
LOCATIONIQ_API_KEY="your_locationiq_api_key"
